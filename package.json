{
	"name": "figma-template-converter",
	"version": "1.0.0",
	"private": true,
	"description": "Convert Figma designs to fillable PDF templates with AI",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"prepare": "husky",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	},
	"optionalDependencies": {
		"@tailwindcss/oxide-linux-x64-gnu": "^4.1.17",
		"lightningcss-linux-x64-gnu": "^1.30.2"
	},
	"dependencies": {
		"@ant-design/icons": "6.0.0",
		"@ant-design/nextjs-registry": "^1.2.0",
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"antd": "^5.28.0",
		"html-react-parser": "^5.2.10",
		"html2canvas": "^1.4.1",
		"jspdf": "^3.0.4",
		"next": "16.0.1",
		"openai": "^4.77.3",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-syntax-highlighter": "^15.6.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.17",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/estree": "^1.0.8",
		"@types/node": "^20.19.24",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@types/react-syntax-highlighter": "^15.5.13",
		"eslint": "^9.39.1",
		"eslint-config-next": "16.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.12.4",
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.2",
			"@types/react-dom": "19.2.2"
		}
	}
}
